# Copy to backend/.env (or set system variables) only if using Gemini Vision.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated list of origins allowed to call the API (development only).
# In production the API and built UI normally share one origin, so leave
# ALLOWED_ORIGINS empty and the same-origin requests need no CORS entry.
# Example for separate hosting: https://your-app.example,https://api.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time API address.
#   - npm run dev  -> defaults to http://127.0.0.1:8000 when unset
#   - npm run build -> defaults to the SAME origin as the served UI (''),
#     set this only when the API lives on another host / path.
VITE_API_URL=